NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1

# Callable function names (adjust to match backend)
NEXT_PUBLIC_ENGAGEMENT_FUNCTION_NAME=getEngagementScore
NEXT_PUBLIC_CREATE_SUBSCRIPTION_FUNCTION=createRazorpaySubscription
NEXT_PUBLIC_GET_RAZORPAY_CONFIG_FUNCTION_NAME=getRazorpayConfig

# Razorpay plan for web subscription (must be a valid plan_... from Razorpay)
NEXT_PUBLIC_RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxx
# Optional: use a different plan for Preview deployments (Vercel)
NEXT_PUBLIC_RAZORPAY_PLAN_ID_PREVIEW=plan_test_xxxxxxxxx
# Optional: force using the preview/test plan in any environment (set to '1')
NEXT_PUBLIC_FORCE_TEST_PLAN=0

# Stripe (client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PRICE_STARTER=price_xxx_monthly_basic
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_xxx_monthly_pro
NEXT_PUBLIC_STRIPE_PRICE_ENTERPRISE=price_xxx_monthly_enterprise
NEXT_PUBLIC_STRIPE_PRICE_OT_STARTER=price_xxx_onetime_starter
NEXT_PUBLIC_STRIPE_PRICE_OT_PRO=price_xxx_onetime_pro
NEXT_PUBLIC_STRIPE_PRICE_OT_ENTERPRISE=price_xxx_onetime_enterprise
NEXT_PUBLIC_STRIPE_PRODUCT_OT_STARTER=prod_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_OT_PRO=prod_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_OT_ENTERPRISE=prod_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_SUB_STARTER=prod_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_SUB_PRO=prod_xxx
NEXT_PUBLIC_STRIPE_PRODUCT_SUB_ENTERPRISE=prod_xxx

# Rewardful affiliate tracking
NEXT_PUBLIC_REWARDFUL_KEY=

# Server-side secrets (set in your cloud environment, e.g., Vercel)
# FIREBASE_PRIVATE_KEY=
# REVALIDATE_TOKEN=
# ADMIN_HTTP_KEY=

# The following are set in the Firebase Functions environment
# OPENAI_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# MAYIN_PERPLEXITY_KEY=
# RAPID_API_KEY=